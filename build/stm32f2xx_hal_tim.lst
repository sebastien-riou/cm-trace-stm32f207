7545:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_tim.c ****   *          This parameter must be a value between 0x00 and 0x0F
7546:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_tim.c ****   * @retval None
7547:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_tim.c ****   */
