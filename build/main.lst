  93:Core/Src/main.c **** void cmtrace_timer_init(){
  94:Core/Src/main.c **** 	//nothing to do, done already in main code
  95:Core/Src/main.c **** 	//printf("cmtrace_timer_init\n");
  96:Core/Src/main.c **** 	DBGMCU->APB1FZ|=0x8;//halt timer during debug mode
  97:Core/Src/main.c **** 
  98:Core/Src/main.c **** 	SET_BIT(TIM5->CCER, TIM_CCER_CC1E);
  99:Core/Src/main.c **** }
 100:Core/Src/main.c **** void cmtrace_timer_start(uint32_t cycles){
 101:Core/Src/main.c **** 	//printf("cmtrace_timer_start %lu\n",cycles);
 102:Core/Src/main.c **** 	WRITE_REG(TIM5->ARR, cycles);
 103:Core/Src/main.c **** 	LL_TIM_SetCounter(TIM5,0);
 104:Core/Src/main.c **** 	CLEAR_BIT(TIM5->SR, TIM_SR_UIF);
 105:Core/Src/main.c **** 	SET_BIT(TIM5->DIER, TIM_DIER_UIE);
 106:Core/Src/main.c **** 	SET_BIT(TIM5->CR1, TIM_CR1_OPM);//set one pulse mode
 107:Core/Src/main.c **** 	LL_TIM_OC_SetCompareCH1(htim5.Instance,cycles);
 108:Core/Src/main.c **** 	led1_on();
 109:Core/Src/main.c **** 	SET_BIT(TIM5->CR1, TIM_CR1_CEN);
 110:Core/Src/main.c **** }
 111:Core/Src/main.c **** void cmtrace_timer_stop(){
 112:Core/Src/main.c **** 	CLEAR_BIT(TIM5->CR1, TIM_CR1_CEN);//stop timer
 113:Core/Src/main.c **** 	led1_off();
 114:Core/Src/main.c **** 	//printf("cmtrace_timer_stop\n");
 115:Core/Src/main.c **** }
 116:Core/Src/main.c **** void cmtrace_timer_irq_ack(){
 117:Core/Src/main.c **** 	led1_off();
 118:Core/Src/main.c **** 	cmtrace_timer_stop();
 119:Core/Src/main.c **** 	__HAL_TIM_CLEAR_FLAG(&htim5, TIM_FLAG_UPDATE);
 120:Core/Src/main.c **** 	CLEAR_BIT(TIM5->DIER, TIM_DIER_UIE);
 121:Core/Src/main.c **** 	//printf("cmtrace_timer_irq_ack\n");
 122:Core/Src/main.c **** }
 123:Core/Src/main.c **** uint32_t cmtrace_timer_read(){
 124:Core/Src/main.c **** 	return LL_TIM_GetCounter(TIM5);
 125:Core/Src/main.c **** }
